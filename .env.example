# Copy to .env for local development. Never commit real secrets.
# All values below are local-only placeholders.

RESUMEMAKER_ENV=local

# PostgreSQL. The project expects PostgreSQL 14+.
RESUMEMAKER_DATABASE_URL=postgresql+psycopg://resumemaker:resumemaker@127.0.0.1:5432/resumemaker

# Used by the fake payment provider to sign webhooks in tests and local flows.
RESUMEMAKER_FAKE_PAYMENT_SECRET=local-fake-secret-change-me

# Exposes POST /payments/fake/webhook so local flows can be exercised without a real acquirer.
# Must stay false outside local/test environments.
RESUMEMAKER_ENABLE_FAKE_WEBHOOK_ENDPOINT=true

# Internal credits granted to every new user. Must cover one preview generation.
RESUMEMAKER_INITIAL_GRANT_CREDITS=100

# Real payment and LLM providers are not implemented in sprint 1 and are not configured here.
